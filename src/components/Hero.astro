---
---

<section id="inicio" class="relative overflow-hidden pt-16">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container-site relative grid items-center gap-12 py-20 lg:grid-cols-[1.1fr_1fr] lg:py-28">
    <!-- Texto -->
    <div>
      <p class="eyebrow mb-4">Hola, soy</p>
      <h1 class="text-5xl leading-none font-extrabold tracking-tight sm:text-6xl lg:text-7xl">
        Enderson<br />
        <span class="text-gradient">Montaña</span>
      </h1>
      <p class="mt-5 max-w-xl text-xl font-semibold text-(--color-text) sm:text-2xl">
        Coordinador de IT &amp; Tech Lead — construyo software empresarial y los agentes de IA
        que lo desarrollan.
      </p>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-(--color-dim)">
        Full Stack Developer con <strong class="text-(--color-text)">8 años de experiencia</strong>,
        especialista en backend con .NET, Node.js y SQL Server. Hoy lidero equipos que integran
        <strong class="text-(--color-text)">IA en el ciclo de desarrollo</strong> — agentes autónomos,
        servidores MCP, RAG — y despliegan sobre <strong class="text-(--color-text)">AWS con Terraform</strong>.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#proyectos" class="btn-primary">Ver proyectos</a>
        <a href="/cv" class="btn-ghost">Ver CV</a>

        <div class="ml-1 flex items-center gap-1">
          <a
            href="https://github.com/ejmontana"
            target="_blank"
            rel="noopener"
            aria-label="GitHub"
            class="rounded-lg p-2.5 text-(--color-dim) transition-colors hover:bg-(--color-surface) hover:text-(--color-text)"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
          <a
            href="https://linkedin.com/in/enderson-montana"
            target="_blank"
            rel="noopener"
            aria-label="LinkedIn"
            class="rounded-lg p-2.5 text-(--color-dim) transition-colors hover:bg-(--color-surface) hover:text-(--color-text)"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path>
            </svg>
          </a>
          <a
            href="mailto:enderson_josep@hotmail.com"
            aria-label="Email"
            class="rounded-lg p-2.5 text-(--color-dim) transition-colors hover:bg-(--color-surface) hover:text-(--color-text)"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Terminal: guiño al orquestador real -->
    <div class="terminal" data-reveal>
      <div class="flex items-center gap-2 border-b border-(--color-line) px-4 py-3">
        <span class="terminal-dot bg-(--color-red)"></span>
        <span class="terminal-dot bg-(--color-amber)"></span>
        <span class="terminal-dot bg-(--color-green)"></span>
        <span class="ml-3 text-xs text-(--color-dim)">symphony · orquestador de agentes</span>
      </div>
      <div class="space-y-1.5 px-5 py-5">
        <p><span class="text-(--color-green)">$</span> <span class="text-(--color-text)">symphony start --workflow WORKFLOW.md</span></p>
        <p class="text-(--color-dim)"><span class="text-(--color-green)">✔</span> Linear conectado · 3 tickets en cola</p>
        <p class="text-(--color-dim)"><span class="text-(--color-green)">✔</span> MCP servers: <span class="text-(--color-blue)">sqlserver</span>, <span class="text-(--color-blue)">linear</span></p>
        <p class="text-(--color-dim)"><span class="text-(--color-amber)">▸</span> GAL-142 → agente #1 · implementando…</p>
        <p class="text-(--color-dim)"><span class="text-(--color-amber)">▸</span> GAL-143 → agente #2 · abriendo PR…</p>
        <p class="text-(--color-dim)"><span class="text-(--color-green)">✔</span> GAL-139 → <span class="text-(--color-green)">merged</span> · turno 4/20 · 12.4k tokens</p>
        <p class="pt-1"><span class="text-(--color-green)">$</span> <span class="cursor-blink" aria-hidden="true"></span></p>
      </div>
    </div>
  </div>

  <div class="border-b border-(--color-line)"></div>
</section>
