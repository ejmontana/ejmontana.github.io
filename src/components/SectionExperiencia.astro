---

<section id="experiencia" class="py-20 lg:py-28">
  <div class="container-site">
    <p class="eyebrow" data-reveal>// Trayectoria</p>
    <h2 class="mt-3 text-3xl font-bold sm:text-4xl" data-reveal>
      8 años del POS al <span class="text-gradient">pipeline de agentes.</span>
    </h2>

    <div class="mt-12 grid gap-12 lg:grid-cols-[1.5fr_1fr]">
      <!-- Timeline -->
      <div class="timeline space-y-10 pl-9">
        {
          jobs.map((job) => (
            <article class="relative" data-reveal>
              <span class="timeline-dot" style={job.current ? '' : 'border-color: var(--color-line);'} aria-hidden="true"></span>
              <header class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <h3 class="text-lg font-bold">{job.role}</h3>
                {job.current && <span class="chip-green chip !text-[11px]">actual</span>}
              </header>
              <p class="mt-1 text-sm text-(--color-dim)">
                <span class="font-semibold text-(--color-blue)">{job.company}</span> · {job.place}
              </p>
              <p class="font-mono text-xs text-(--color-dim)">{job.period}</p>
              <ul class="mt-3 space-y-2">
                {job.bullets.map((bullet) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-(--color-dim)">
                    <span class="mt-0.5 text-(--color-blue)" aria-hidden="true">
                      ▸
                    </span>
                    {bullet}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <!-- Educación -->
      <aside data-reveal>
        <h3 class="font-mono text-sm font-semibold tracking-widest text-(--color-purple) uppercase">
          Educación
        </h3>
        <div class="mt-5 space-y-4">
          {
            education.map((item) => (
              <div class="card p-5">
                <h4 class="font-bold">{item.title}</h4>
                <p class="mt-1 text-sm text-(--color-dim)">{item.institution}</p>
                <p class="mt-1 font-mono text-xs text-(--color-dim)">{item.detail}</p>
              </div>
            ))
          }
        </div>
      </aside>
    </div>
  </div>
</section>
