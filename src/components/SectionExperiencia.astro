const education = [
  {
    title: 'Ingeniería Informática',
    institution: 'Universidad Alejandro de Humboldt',
    detail: '10.º semestre · En curso',
  },
  {
    title: 'T.S.U. en Informática',
    institution: 'Instituto Universitario de Tecnología (IUTA)',
    detail: 'Graduado · Junio 2019',
  },
  {
    title: 'Certificación en Administración',
    institution: 'Instituto Adiestra — INCES',
    detail: '2019',
  },
