    company: 'Naxmek Business S.R.L.',
    place: 'República Dominicana · Remoto, jornada parcial',
    period: 'Jun 2024 — Actualidad',
    current: true,
    bullets: [
      'Soluciones empresariales con .NET Core para mercado internacional.',
      'Arquitectura de APIs REST escalables; mentoría y code review en equipo distribuido.',
