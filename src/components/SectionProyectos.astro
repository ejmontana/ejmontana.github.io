---
const projects = [
  {
    title: 'medi-dosis',
    description:
      'Calculadora de dosificación de medicamentos con validación de fármacos de alto riesgo, conversión de unidades y funcionamiento offline. Demo técnica con fines educativos — no destinada a uso clínico.',
    tech: ['React 19', 'TypeScript', 'Zod', 'Vite'],
    github: 'https://github.com/ejmontana/medi-dosis',
    demo: 'https://medi-dosis.vercel.app',
  },
  {
    title: 'crud-user-admin',
    description:
      'Aplicación full stack de gestión de usuarios y productos: API REST con JWT, carga de imágenes y asistente conversacional con IA sobre el catálogo.',
    tech: ['Express', 'TypeScript', 'SQL Server', 'OpenAI'],
    github: 'https://github.com/ejmontana/crud-user-admin',
    demo: null,
  },
  {
    title: 'portalCautivo',
    description:
      'Portal cautivo WiFi con registro de usuarios, panel de administración, analíticas y gestión de anuncios.',
    tech: ['React', 'TypeScript', 'Tailwind'],
    github: 'https://github.com/ejmontana/portalCautivo',
    demo: null,
  },
  {
    title: 'simulacion-newton',
    description:
      'Simulación interactiva de las leyes de Newton para visualizar fuerza, masa y aceleración.',
    tech: ['React', 'Bootstrap'],
    github: 'https://github.com/ejmontana/simulacion-newton',
    demo: 'https://simulacion-newton.vercel.app',
  },
];
---

<section id="proyectos" class="border-y border-(--color-line) bg-(--color-surface)/40 py-20 lg:py-28">
  <div class="container-site">
    <p class="eyebrow" data-reveal>// Proyectos públicos</p>
    <h2 class="mt-3 text-3xl font-bold sm:text-4xl" data-reveal>
      Código que puedes <span class="text-gradient">leer hoy mismo.</span>
    </h2>
    <p class="mt-4 max-w-2xl text-(--color-dim)" data-reveal>
      Lo mejor de mi trabajo vive en repos privados por acuerdos de confidencialidad — los detalles
      de arquitectura los cuento con gusto en una entrevista. Esto es lo que sí puedes revisar:
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {
        projects.map((project) => (
          <article class="card flex flex-col p-6" data-reveal>
            <div class="flex items-start justify-between gap-4">
              <h3 class="font-mono text-lg font-bold text-(--color-blue)">{project.title}</h3>
              <div class="flex shrink-0 items-center gap-2">
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener"
                  aria-label={`Código de ${project.title} en GitHub`}
                  class="rounded-md p-1.5 text-(--color-dim) transition-colors hover:text-(--color-text)"
                >
                  <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      fill-rule="evenodd"
                      d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </a>
                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener"
                    aria-label={`Demo de ${project.title}`}
                    class="rounded-md p-1.5 text-(--color-dim) transition-colors hover:text-(--color-text)"
                  >
                    <svg
                      class="h-5 w-5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
                      />
                    </svg>
                  </a>
                )}
              </div>
            </div>
            <p class="mt-3 grow text-sm leading-relaxed text-(--color-dim)">{project.description}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {project.tech.map((tech) => (
                <span class="chip">{tech}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-8 text-center" data-reveal>
      <a
        href="https://github.com/ejmontana?tab=repositories"
        target="_blank"
        rel="noopener"
        class="btn-ghost"
      >
        Ver todos los repos en GitHub →
      </a>
    </p>
  </div>
</section>
